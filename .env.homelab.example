# cp .env.homelab.example .env.homelab
# Chạy: docker compose --env-file .env.homelab -f compose.homelab.yaml up -d --build
#
# TRAEFIK_NETWORK phải trùng mạng Docker mà Traefik đang gắn.
# Example frontend ghi traefik_net, example backend ghi proxy.
# Trên server: docker inspect <container-traefik> rồi copy đúng tên network.

TRAEFIK_NETWORK=traefik_net
TRAEFIK_ENTRYPOINT=websecure
AIRFLOW_HOST=airflow.ailusion.io.vn
AIRFLOW_HOST_PORT=8081

# UID user deploy trên server (`id -u`). Lệch UID thì file log và DAG thuộc quyền sai.
AIRFLOW_UID=50000

POSTGRES_USER=airflow
# openssl rand -hex 24
# Dùng hex để khỏi ký tự đặc biệt làm hỏng connection string.
POSTGRES_PASSWORD=
POSTGRES_DB=airflow

# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW__CORE__FERNET_KEY=
# openssl rand -hex 32
AIRFLOW__API__SECRET_KEY=

AIRFLOW_ADMIN_USERNAME=
AIRFLOW_ADMIN_PASSWORD=
