# Copy file này thành .env trước khi chạy docker compose.

# UID chạy container. Linux thì đặt bằng `id -u`; macOS để 50000 là được.
AIRFLOW_UID=50000

# Port web UI trên máy host.
# Đặt 8081 vì finance-intelligence-hub đang giữ 8080 và có restart: always,
# nên nó tự bật lại mỗi khi Docker Desktop khởi động.
AIRFLOW_PORT=8081
FLOWER_PORT=5556

# Tài khoản đăng nhập web UI
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=admin

# Nạp DAG mẫu của Airflow để thử nhanh khi repo chưa có DAG nào.
# Đặt false khi đã có DAG thật.
AIRFLOW__CORE__LOAD_EXAMPLES=false

# Kho du lieu: database MLAI-AILUSION tren ailusion.io.vn, dang nhap user ailusion.
# Mat khau co ky tu @ nen phai ma hoa thanh %40 trong URI.
AIRFLOW_CONN_MLAI_AILUSION=postgresql://ailusion:<mat-khau>@ailusion.io.vn:5432/MLAI-AILUSION
